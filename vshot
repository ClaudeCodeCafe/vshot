#!/bin/bash
set -eo pipefail

# ── vshot — Video frame extraction for AI consumption ──────────────────────
# Extract frames from video and optionally create a montage grid image.
# Designed to let AI assistants "watch" videos via image analysis.

VERSION="0.3.0"
SCRIPT_NAME="vshot"

# Unique prefix per run to avoid stale frame collisions (#1)
# Include epoch seconds to prevent PID-reuse collisions
RUN_ID="$$_$(date +%s)"

# ── Defaults ───────────────────────────────────────────────────────────────
MODE="overview"
FRAMES=20
INTERVAL=""
MONTAGE=false
OUTPUT_DIR=""
TIMESTAMPS=true
NAME=""
CLEANUP=false
SCENE=""
AT=""
COLS_OPT=""
JSON=false
CLEANED=false

# ── Usage ──────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${SCRIPT_NAME} v${VERSION} — Video frame extraction for AI consumption

USAGE:
  ${SCRIPT_NAME} <video> [options]

OPTIONS:
  --frames N        Number of frames to extract (default: 20)
                    Note: capped to video duration in seconds for even spacing.
  --interval N      Extract every N seconds (overrides --frames)
  --scene [N]       Extract only scene-change frames (threshold 0.0-1.0, default: 0.3)
                    Lower = more frames, higher = fewer frames. Overrides --frames.
  --at LIST         Extract frames at specific times in seconds (comma-separated,
                    decimals allowed, e.g. 3.5,12,48). Overrides --frames/--interval/--scene.
  --mode MODE       overview | text | detail (default: overview)
  --montage         Combine all frames into a single grid image
  --cols N          Number of montage grid columns (default: auto from aspect ratio)
  --name NAME       Montage file name, without directory (default: <video>_montage_<run-id>.jpg)
                    Stable names make pipelines simpler; re-runs overwrite the file.
  --output DIR      Output directory (default: <video>_vshot/)
  --no-timestamps   Don't burn timestamps into extracted frames
  --cleanup         Remove individual frames after creating montage
  --json            Print a machine-readable JSON result line to stdout
                    (human-readable progress goes to stderr)
  -h, --help        Show this help

MODES:
  overview   480x270   Low-res color. Quick overview of video flow.
  text       960x540   Mid-res. Optimized for reading text/UI content.
  detail     1280x720  High-res. Full detail for design review.

EXAMPLES:
  ${SCRIPT_NAME} video.mp4                          # 20 frames, overview
  ${SCRIPT_NAME} video.mp4 --montage                # single grid image
  ${SCRIPT_NAME} video.mp4 --mode text --montage    # text-readable grid
  ${SCRIPT_NAME} video.mp4 --interval 5 --montage   # every 5s, grid
  ${SCRIPT_NAME} video.mp4 --frames 30 --mode detail # 30 high-res frames
  ${SCRIPT_NAME} video.mp4 --scene --montage         # scene changes only
  ${SCRIPT_NAME} video.mp4 --scene 0.5 --montage     # fewer scene changes
  ${SCRIPT_NAME} video.mp4 --at 3.5,12,48 --montage  # pinpoint extraction (labels keep decimals: 0:03.5)
  ${SCRIPT_NAME} video.mp4 --montage --name review    # fixed file name: review.jpg
  ${SCRIPT_NAME} video.mp4 --montage --json          # machine-readable result
EOF
  exit 0
}

# ── Mode resolution lookup ─────────────────────────────────────────────────
get_mode_settings() {
  case "$MODE" in
    overview) W=480;  H=270; Q=70 ;;
    text)     W=960;  H=540; Q=85 ;;
    detail)   W=1280; H=720; Q=90 ;;
    *) echo "Error: unknown mode '$MODE'. Use: overview, text, detail" >&2; exit 1 ;;
  esac
}

# ── Dependency check (#8, #14) ─────────────────────────────────────────────
check_deps() {
  if ! command -v ffmpeg &>/dev/null; then
    echo "Error: ffmpeg is required. Install with your package manager, e.g. brew install ffmpeg" >&2
    exit 1
  fi
  if ! command -v ffprobe &>/dev/null; then
    echo "Error: ffprobe is required (comes with ffmpeg). Install with your package manager, e.g. brew install ffmpeg" >&2
    exit 1
  fi
  if $MONTAGE && ! command -v montage &>/dev/null; then
    echo "Error: ImageMagick is required for --montage. Install with your package manager, e.g. brew install imagemagick" >&2
    exit 1
  fi
}

# ── Validation helpers (#2) ────────────────────────────────────────────────
is_positive_integer() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    0) return 1 ;;
    *) return 0 ;;
  esac
}

# Format seconds (int or float) as M:SS for display.
# Fractional input (e.g. --at 3.5) keeps one decimal — M:SS.d — so two
# pinpoint frames inside the same second stay distinguishable in the montage.
format_ts() {
  echo "$1" | awk '{s = $1 + 0; m = int(s / 60); r = s - m * 60;
    if (r == int(r)) printf "%d:%02d", m, r; else printf "%d:%04.1f", m, r}'
}

# ── JSON result output (--json) ────────────────────────────────────────────
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Emit one JSON line to fd 3 (the original stdout). No-op without --json.
emit_json() {
  $JSON || return 0
  local out_abs files_json montage_json i fpath
  out_abs=$(cd -- "$OUTPUT_DIR" 2>/dev/null && pwd)
  [ -z "$out_abs" ] && out_abs="$OUTPUT_DIR"
  files_json=""
  if ! $CLEANED && [ "${#FRAME_FILES[@]}" -gt 0 ]; then
    i=0
    for fpath in "${FRAME_FILES[@]}"; do
      [ -n "$files_json" ] && files_json="${files_json},"
      files_json="${files_json}{\"path\":\"$(json_escape "${out_abs}/$(basename -- "$fpath")")\",\"time\":${FRAME_TIMES[$i]}}"
      i=$((i + 1))
    done
  fi
  if [ -n "${MONTAGE_FILE:-}" ] && [ -s "${MONTAGE_FILE:-}" ]; then
    montage_json="\"$(json_escape "${out_abs}/$(basename -- "$MONTAGE_FILE")")\""
  else
    montage_json="null"
  fi
  printf '{"video":"%s","duration":%s,"mode":"%s","frames":%s,"output_dir":"%s","montage":%s,"files":[%s]}\n' \
    "$(json_escape "$VIDEO")" "$DURATION" "$MODE" "${EXTRACTED:-0}" \
    "$(json_escape "$out_abs")" "$montage_json" "$files_json" >&3
}

# ── Font detection (shared by timestamp burn-in and montage) ──────────────
# Homebrew ImageMagick / ffmpeg often lack default font config.
# Detect a usable system font once and reuse it.
DETECTED_FONT=""
detect_font() {
  if [ -n "$DETECTED_FONT" ]; then
    return
  fi
  if command -v fc-match &>/dev/null; then
    DETECTED_FONT=$(fc-match -f '%{file}' 2>/dev/null || true)
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      return
    fi
    DETECTED_FONT=""
  fi
  # Search common system font paths as last resort
  local font_path
  for font_path in \
    /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    /usr/share/fonts/TTF/DejaVuSans.ttf \
    /System/Library/Fonts/Helvetica.ttc \
    /System/Library/Fonts/Geneva.ttf; do
    if [ -f "$font_path" ]; then
      DETECTED_FONT="$font_path"
      return
    fi
  done
  echo "Warning: no usable font found. Timestamps and montage labels may fail." >&2
}

# ── Parse args (#7: check $# before accessing $2) ─────────────────────────
VIDEO=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    -v|--version) echo "${SCRIPT_NAME} v${VERSION}"; exit 0 ;;
    --frames)
      if [ $# -lt 2 ]; then
        echo "Error: --frames requires a value" >&2; exit 1
      fi
      FRAMES="$2"; shift 2 ;;
    --interval)
      if [ $# -lt 2 ]; then
        echo "Error: --interval requires a value" >&2; exit 1
      fi
      INTERVAL="$2"; shift 2 ;;
    --mode)
      if [ $# -lt 2 ]; then
        echo "Error: --mode requires a value" >&2; exit 1
      fi
      MODE="$2"; shift 2 ;;
    --montage) MONTAGE=true; shift ;;
    --output)
      if [ $# -lt 2 ]; then
        echo "Error: --output requires a value" >&2; exit 1
      fi
      OUTPUT_DIR="$2"; shift 2 ;;
    --scene)
      # --scene can optionally take a threshold value (0.0-1.0)
      if [ $# -ge 2 ] && echo "$2" | grep -qE '^(0|0?\.[0-9]+|1(\.0+)?)$'; then
        SCENE="$2"; shift 2
      else
        SCENE="0.3"; shift
      fi ;;
    --at)
      if [ $# -lt 2 ]; then
        echo "Error: --at requires a value" >&2; exit 1
      fi
      AT="$2"; shift 2 ;;
    --cols)
      if [ $# -lt 2 ]; then
        echo "Error: --cols requires a value" >&2; exit 1
      fi
      COLS_OPT="$2"; shift 2 ;;
    --name)
      if [ $# -lt 2 ]; then
        echo "Error: --name requires a value" >&2; exit 1
      fi
      NAME="$2"; shift 2 ;;
    --json) JSON=true; shift ;;
    --no-timestamps) TIMESTAMPS=false; shift ;;
    --cleanup) CLEANUP=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *)
      if [ -z "$VIDEO" ]; then
        VIDEO="$1"
      else
        echo "Error: multiple video files not supported" >&2; exit 1
      fi
      shift ;;
  esac
done

# ── Input validation (#2) ─────────────────────────────────────────────────
if [ -n "$NAME" ]; then
  case "$NAME" in
    */*|.|..) echo "Error: --name must be a plain file name (no path separators)" >&2; exit 1 ;;
  esac
  NAME="${NAME%.jpg}"
fi
if [ -z "$VIDEO" ]; then
  echo "Error: no video file specified" >&2
  echo "Usage: ${SCRIPT_NAME} <video> [options]" >&2
  exit 1
fi

if [ ! -f "$VIDEO" ]; then
  echo "Error: file not found: $VIDEO" >&2
  exit 1
fi

if ! is_positive_integer "$FRAMES"; then
  echo "Error: --frames must be a positive integer, got '$FRAMES'" >&2
  exit 1
fi

if [ -n "$INTERVAL" ]; then
  if ! is_positive_integer "$INTERVAL"; then
    echo "Error: --interval must be a positive integer, got '$INTERVAL'" >&2
    exit 1
  fi
fi

if [ -n "$COLS_OPT" ] && ! is_positive_integer "$COLS_OPT"; then
  echo "Error: --cols must be a positive integer, got '$COLS_OPT'" >&2
  exit 1
fi

# Parse --at into a validated list (range check happens after duration probe)
AT_MODE=false
AT_RAW=()
if [ -n "$AT" ]; then
  AT_MODE=true
  set -f # no glob expansion of user input
  for t in $(echo "$AT" | tr ',' ' '); do
    if ! echo "$t" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
      echo "Error: --at times must be numbers in seconds, got '$t'" >&2
      exit 1
    fi
    AT_RAW+=("$t")
  done
  set +f
  if [ "${#AT_RAW[@]}" -eq 0 ]; then
    echo "Error: --at requires at least one time value" >&2
    exit 1
  fi
fi

get_mode_settings
check_deps

# --json: route human-readable progress to stderr, keep original stdout on fd 3
if $JSON; then
  exec 3>&1 1>&2
fi

# ── Temp file for capturing stderr (#3) ───────────────────────────────────
STDERR_TMP=$(mktemp "${TMPDIR:-/tmp}/vshot_stderr.XXXXXX")
cleanup_tmp() {
  rm -f -- "$STDERR_TMP" "${SCENE_PTS_LOG:-}" 2>/dev/null || true
}
trap cleanup_tmp EXIT

# ── Get video info (#3: capture stderr, check exit codes) ─────────────────
if ! DURATION=$(ffprobe -v error -show_entries format=duration -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP") || [ -z "$DURATION" ]; then
  echo "Error: could not determine video duration" >&2
  if [ -s "$STDERR_TMP" ]; then
    echo "  ffprobe: $(cat "$STDERR_TMP")" >&2
  fi
  exit 1
fi
DURATION=$(echo "$DURATION" | head -1)

# Handle sub-second durations gracefully (#9)
# Use awk instead of bc for portability (#8)
DURATION_INT=$(echo "$DURATION" | awk '{d = int($1); if (d < 1 && $1 > 0) d = 1; print d}')

if [ -z "$DURATION_INT" ] || [ "$DURATION_INT" -eq 0 ] 2>/dev/null; then
  echo "Error: could not determine video duration (got: $DURATION)" >&2
  exit 1
fi

# Sort --at times and drop ones beyond the video duration
if $AT_MODE; then
  AT_ARR=()
  for t in $(printf '%s\n' "${AT_RAW[@]}" | sort -n); do
    if awk -v t="$t" -v d="$DURATION" 'BEGIN{exit !(t < d)}'; then
      AT_ARR+=("$t")
    else
      echo "Warning: --at ${t}s is beyond video duration (${DURATION_INT}s). Skipping." >&2
    fi
  done
  if [ "${#AT_ARR[@]}" -eq 0 ]; then
    echo "Error: all --at times are beyond video duration (${DURATION_INT}s)" >&2
    exit 1
  fi
fi

# Detect original video dimensions (#3, #9, #10: -- before path)
if ! V_WIDTH=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP"); then
  V_WIDTH=""
fi
V_WIDTH=$(echo "$V_WIDTH" | head -1 | tr -d ',[:space:]')

if ! V_HEIGHT=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP"); then
  V_HEIGHT=""
fi
V_HEIGHT=$(echo "$V_HEIGHT" | head -1 | tr -d ',[:space:]')

# Validate dimensions (#9)
if [ -z "$V_WIDTH" ] || [ -z "$V_HEIGHT" ]; then
  echo "Error: could not determine video dimensions" >&2
  if [ -s "$STDERR_TMP" ]; then
    echo "  ffprobe: $(cat "$STDERR_TMP")" >&2
  fi
  exit 1
fi
if ! is_positive_integer "$V_WIDTH" || ! is_positive_integer "$V_HEIGHT"; then
  echo "Error: could not determine valid video dimensions (${V_WIDTH}x${V_HEIGHT})" >&2
  exit 1
fi

# Check for rotation metadata (phone videos often store landscape dims + 90° rotation)
V_ROTATION=$(ffprobe -v error -select_streams v:0 -show_entries stream_side_data=rotation -of csv=p=0 -- "$VIDEO" 2>/dev/null | head -1 | tr -d '[:space:]-')
# Swap dimensions if rotated 90 or 270 degrees
if [ "$V_ROTATION" = "90" ] || [ "$V_ROTATION" = "270" ]; then
  V_TMP=$V_WIDTH
  V_WIDTH=$V_HEIGHT
  V_HEIGHT=$V_TMP
fi

# Adjust output dimensions to match source aspect ratio (#8: awk instead of bc)
if [ -n "$V_WIDTH" ] && [ -n "$V_HEIGHT" ] && [ "$V_WIDTH" -gt 0 ]; then
  if [ "$V_HEIGHT" -gt "$V_WIDTH" ]; then
    # Portrait (9:16 etc) — fix height to mode height, scale width proportionally
    H_OUT=$H
    W_OUT=$(echo "$H_OUT $V_WIDTH $V_HEIGHT" | awk '{printf "%d", $1 * $2 / $3}')
    # Ensure even number (ffmpeg requires it)
    W_OUT=$(( (W_OUT / 2) * 2 ))
    ORIENTATION="portrait"
  else
    # Landscape (16:9 etc) — fix width to mode width, scale height proportionally
    W_OUT=$W
    H_OUT=$(echo "$W_OUT $V_HEIGHT $V_WIDTH" | awk '{printf "%d", $1 * $2 / $3}')
    H_OUT=$(( (H_OUT / 2) * 2 ))
    ORIENTATION="landscape"
  fi
  # Clamp to minimum 2 for extreme aspect ratios
  [ "$W_OUT" -lt 2 ] && W_OUT=2
  [ "$H_OUT" -lt 2 ] && H_OUT=2
else
  W_OUT=$W
  H_OUT=$H
  ORIENTATION="landscape"
fi

# ── Calculate frame extraction rate ────────────────────────────────────────
SCENE_MODE=false
if $AT_MODE; then
  # Pinpoint mode: one ffmpeg seek per requested time (see extraction below)
  FRAMES="${#AT_ARR[@]}"
elif [ -n "$SCENE" ]; then
  # Scene detection: extract only frames where visual change exceeds threshold
  SCENE_MODE=true
  # showinfo captures PTS for accurate timestamps on scene-detected frames
  SCENE_PTS_LOG=$(mktemp "${TMPDIR:-/tmp}/vshot_pts.XXXXXX")
  VF_FILTER="select='gt(scene,${SCENE})',showinfo,scale=${W_OUT}:${H_OUT}"
  FRAMES="?"
elif [ -n "$INTERVAL" ]; then
  FPS_FILTER="fps=1/${INTERVAL}"
  VF_FILTER="${FPS_FILTER},scale=${W_OUT}:${H_OUT}"
  # Don't estimate — actual count depends on ffmpeg's fps filter timing
  FRAMES="?"
else
  # (#12) Warn if FRAMES was capped
  if [ "$FRAMES" -gt "$DURATION_INT" ]; then
    echo "Warning: --frames $FRAMES exceeds video duration (${DURATION_INT}s). Capping to $DURATION_INT." >&2
    FRAMES=$DURATION_INT
  fi
  FPS=$(echo "$FRAMES $DURATION" | awk '{printf "%.6f", $1 / $2}')
  FPS_FILTER="fps=${FPS}"
  VF_FILTER="${FPS_FILTER},scale=${W_OUT}:${H_OUT}"
fi

# ── Setup output (#10: -- before path operands) ───────────────────────────
BASENAME=$(basename -- "$VIDEO" | sed 's/\.[^.]*$//')
if [ -z "$OUTPUT_DIR" ]; then
  OUTPUT_DIR="$(dirname -- "$VIDEO")/${BASENAME}_vshot"
fi
# Normalize relative OUTPUT_DIR to prevent special chars breaking find/ffmpeg
# Prefix with ./ unless already absolute or relative (./  ../)
case "$OUTPUT_DIR" in
  /*|./*|../*) ;; # already safe
  *) OUTPUT_DIR="./$OUTPUT_DIR" ;;
esac
mkdir -p -- "$OUTPUT_DIR"

# Frame filename prefix for this run (#1)
FRAME_PREFIX="vshot_${RUN_ID}_frame"

# ── Extract frames (#1, #3, #8, #10) ──────────────────────────────────────
echo "📹 ${SCRIPT_NAME} v${VERSION}"
echo "   Video:    $(basename "$VIDEO") (${DURATION_INT}s, ${V_WIDTH}x${V_HEIGHT} ${ORIENTATION})"
echo "   Mode:     $MODE (${W_OUT}x${H_OUT})"
if $AT_MODE; then
  echo "   At:       $(echo "${AT_ARR[@]}" | tr ' ' ',')s (${FRAMES} frames)"
elif $SCENE_MODE; then
  echo "   Scene:    threshold=${SCENE} (auto frame count)"
elif [ -n "$INTERVAL" ]; then
  echo "   Interval: every ${INTERVAL}s"
else
  echo "   Frames:   $FRAMES"
fi
echo "   Output:   $OUTPUT_DIR/"
echo ""

echo -n "   Extracting frames..."

# (#3) Capture stderr, check exit code
# Scene mode needs -vsync vfr and yuvj420p for JPEG compatibility
EXTRA_OPTS=""
FFMPEG_LOGLEVEL="error"
if $SCENE_MODE; then
  EXTRA_OPTS="-vsync vfr -pix_fmt yuvj420p"
  # Use info level to capture showinfo PTS data for accurate timestamps
  FFMPEG_LOGLEVEL="info"
fi
QV=$(( (100 - Q) * 31 / 100 + 1 ))
FFMPEG_EXIT=0
AT_TIMES=()
if $AT_MODE; then
  : > "$STDERR_TMP"
  n=1
  for t in "${AT_ARR[@]}"; do
    OUT_FRAME="${OUTPUT_DIR}/${FRAME_PREFIX}_$(printf '%04d' "$n").jpg"
    if ! ffmpeg -v error -ss "$t" -i "$VIDEO" \
      -frames:v 1 -update 1 \
      -vf "scale=${W_OUT}:${H_OUT}" \
      -q:v "$QV" \
      "$OUT_FRAME" 2>>"$STDERR_TMP"; then
      FFMPEG_EXIT=1
      break
    fi
    if [ -s "$OUT_FRAME" ]; then
      # Track which times actually produced a frame (keeps timestamps aligned)
      AT_TIMES+=("$t")
      n=$((n + 1))
    else
      rm -f -- "$OUT_FRAME"
      echo "Warning: could not decode a frame at ${t}s. Skipping." >&2
    fi
  done
else
  # shellcheck disable=SC2086
  ffmpeg -v "$FFMPEG_LOGLEVEL" -i "$VIDEO" \
    -vf "${VF_FILTER}" \
    $EXTRA_OPTS \
    -q:v "$QV" \
    "${OUTPUT_DIR}/${FRAME_PREFIX}_%04d.jpg" \
    2>"$STDERR_TMP" || FFMPEG_EXIT=$?
fi

# Extract PTS values from showinfo output for scene mode timestamps
if $SCENE_MODE && [ -s "$STDERR_TMP" ]; then
  grep 'pts_time:' "$STDERR_TMP" | sed 's/.*pts_time:\([0-9.]*\).*/\1/' > "$SCENE_PTS_LOG" 2>/dev/null || true
fi

# (#4) Use find for frame counting (bash 3 compatible)
EXTRACTED=$(find "$OUTPUT_DIR" -name "${FRAME_PREFIX}_*.jpg" -type f 2>/dev/null | wc -l | tr -d ' ')

if [ "$FFMPEG_EXIT" -ne 0 ]; then
  if $SCENE_MODE && [ "$EXTRACTED" -eq 0 ]; then
    # Scene mode: distinguish "no frames matched" from real errors
    # Check if stderr contains actual error messages (beyond showinfo output)
    HAS_REAL_ERROR=false
    if [ -s "$STDERR_TMP" ]; then
      # Filter out showinfo lines — anything remaining is a real error
      if grep -v -E '^\[Parsed_showinfo|pts:|fmt:|config:|n:' "$STDERR_TMP" | grep -qi 'error\|denied\|invalid\|failed\|cannot' 2>/dev/null; then
        HAS_REAL_ERROR=true
      fi
    fi
    if $HAS_REAL_ERROR; then
      echo " FAILED" >&2
      echo "Error: ffmpeg frame extraction failed" >&2
      grep -v -E '^\[Parsed_showinfo' "$STDERR_TMP" >&2
      exit 1
    fi
    # Genuine 0-scene result
    echo " done (0 frames)"
    echo ""
    echo "   ⚠️  No scene changes detected at threshold=${SCENE}. Try a lower value (e.g. --scene 0.2)."
    TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" 2>/dev/null | cut -f1 | tr -d ' ')
    echo "   📁 Total: ${TOTAL_SIZE:-0B} → ${OUTPUT_DIR}/"
    emit_json
    exit 2
  else
    echo " FAILED" >&2
    echo "Error: ffmpeg frame extraction failed" >&2
    if [ -s "$STDERR_TMP" ]; then
      echo "  ffmpeg: $(cat "$STDERR_TMP")" >&2
    fi
    exit 1
  fi
fi

echo " done (${EXTRACTED} frames)"

if [ "$EXTRACTED" -eq 0 ]; then
  if $SCENE_MODE; then
    echo ""
    echo "   ⚠️  No scene changes detected at threshold=${SCENE}. Try a lower value (e.g. --scene 0.2)."
    TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" 2>/dev/null | cut -f1 | tr -d ' ')
    echo "   📁 Total: ${TOTAL_SIZE:-0B} → ${OUTPUT_DIR}/"
    emit_json
    exit 2
  fi
  echo "Error: no frames were extracted" >&2
  exit 1
fi

# ── Per-frame timestamps ───────────────────────────────────────────────────
# Computed once, shared by filename embedding, burn-in, montage labels, --json.
FRAME_FILES=()
FRAME_TIMES=()
if ! $AT_MODE; then
  if [ -n "$INTERVAL" ]; then
    STEP="$INTERVAL"
  else
    STEP=$(echo "$DURATION $EXTRACTED" | awk '{printf "%.4f", $1 / $2}')
  fi
fi
i=0
for frame in "${OUTPUT_DIR}/${FRAME_PREFIX}"_*.jpg; do
  if $AT_MODE; then
    T="${AT_TIMES[$i]}"
  elif $SCENE_MODE && [ -s "$SCENE_PTS_LOG" ]; then
    # Read actual PTS from showinfo log (1-indexed line for 0-indexed i)
    T=$(awk "NR==$((i + 1)){print \$1; exit}" "$SCENE_PTS_LOG")
  else
    T=$(echo "$i $STEP" | awk '{printf "%.2f", $1 * $2}')
  fi
  [ -z "$T" ] && T=0
  # Embed the timestamp into the filename so frame→time mapping survives
  # even when drawtext burn-in fails (missing font / no drawtext filter)
  TS_SUFFIX=$(echo "$T" | awk '{s = $1; m = int(s / 60); r = s - m * 60;
    if (r == int(r)) printf "t%dm%02ds", m, r; else printf "t%dm%04.1fs", m, r}')
  NEW_FRAME="${frame%.jpg}_${TS_SUFFIX}.jpg"
  mv -- "$frame" "$NEW_FRAME"
  FRAME_FILES+=("$NEW_FRAME")
  FRAME_TIMES+=("$T")
  i=$((i + 1))
done

# ── Burn timestamps (#15: count and warn on failures) ─────────────────────
TS_FAILURES=0
if $TIMESTAMPS && [ "$EXTRACTED" -gt 0 ]; then
  echo -n "   Adding timestamps..."
  detect_font
  # Build fontfile option for drawtext if a font was detected
  # Escape colons and backslashes in font path for ffmpeg filter syntax (#6)
  DRAWTEXT_FONT=""
  if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
    ESCAPED_FONT=$(echo "$DETECTED_FONT" | sed "s/\\\\/\\\\\\\\\\\\\\\\/g; s/:/\\\\\\\\:/g; s/'/\\\\\\\\'/g")
    DRAWTEXT_FONT=":fontfile='${ESCAPED_FONT}'"
  fi

  # drawtext can be missing entirely (e.g. Homebrew ffmpeg 8 builds without
  # freetype) — detect once, then fall back to ImageMagick annotate per frame
  HAS_DRAWTEXT=false
  if ffmpeg -hide_banner -filters 2>/dev/null | grep -q drawtext; then
    HAS_DRAWTEXT=true
  fi
  IM_ANNOTATE=$(command -v magick || command -v convert || true)
  IM_FONT=()
  if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
    IM_FONT=(-font "$DETECTED_FONT")
  fi

  i=0
  for frame in "${FRAME_FILES[@]}"; do
    TS=$(format_ts "${FRAME_TIMES[$i]}")
    BURNED=false

    if $HAS_DRAWTEXT; then
      if ffmpeg -v error -y -i "$frame" \
        -vf "drawtext=text='${TS}':x=8:y=h-24:fontsize=16:fontcolor=white:borderw=2:bordercolor=black${DRAWTEXT_FONT}" \
        "${frame}.tmp.jpg" 2>"$STDERR_TMP" && [ -s "${frame}.tmp.jpg" ]; then
        mv -- "${frame}.tmp.jpg" "$frame"
        BURNED=true
      else
        rm -f -- "${frame}.tmp.jpg"
      fi
    fi

    if ! $BURNED && [ -n "$IM_ANNOTATE" ]; then
      if "$IM_ANNOTATE" "$frame" "${IM_FONT[@]}" \
        -gravity southwest -pointsize 16 -fill white -undercolor '#000000' \
        -annotate +8+8 "$TS" \
        "${frame}.tmp.jpg" 2>"$STDERR_TMP" && [ -s "${frame}.tmp.jpg" ]; then
        mv -- "${frame}.tmp.jpg" "$frame"
        BURNED=true
      else
        rm -f -- "${frame}.tmp.jpg"
      fi
    fi

    if ! $BURNED; then
      TS_FAILURES=$((TS_FAILURES + 1))
    fi
    i=$((i + 1))
  done
  if [ "$TS_FAILURES" -eq "$EXTRACTED" ]; then
    echo " FAILED (all ${TS_FAILURES} frames)" >&2
    echo "   ⚠️  All timestamp burn-ins failed. Falling back to filename timestamps (and montage cell labels with --montage)." >&2
  elif [ "$TS_FAILURES" -gt 0 ]; then
    echo " done (${TS_FAILURES}/${EXTRACTED} timestamp burn-in(s) failed — montage will use cell labels)"
  else
    echo " done"
  fi
fi

# ── Create montage (#5: proper error handling) ────────────────────────────
if $MONTAGE && [ "$EXTRACTED" -gt 0 ]; then
  echo -n "   Creating montage..."

  # Calculate grid: aim for a reasonable final image aspect ratio (#8: awk instead of bc)
  if [ -n "$COLS_OPT" ]; then
    COLS="$COLS_OPT"
    [ "$COLS" -gt "$EXTRACTED" ] && COLS="$EXTRACTED"
  else
    if [ "$ORIENTATION" = "portrait" ]; then
      # Portrait frames: more columns to fill horizontal space
      COLS=$(echo "$EXTRACTED" | awk '{printf "%d", sqrt($1 * 2)}')
    else
      # Landscape frames: standard 16:9-ish grid
      COLS=$(echo "$EXTRACTED" | awk '{printf "%d", sqrt($1 * 16 / 9)}')
    fi
    [ "$COLS" -lt 2 ] && COLS=2
  fi
  ROWS=$(( (EXTRACTED + COLS - 1) / COLS ))

  TILE="${COLS}x${ROWS}"
  if [ -n "$NAME" ]; then
    # --name: stable, caller-chosen montage file name (overwrites on re-run)
    MONTAGE_FILE="${OUTPUT_DIR}/${NAME}.jpg"
  else
    MONTAGE_FILE="${OUTPUT_DIR}/${BASENAME}_montage_${RUN_ID}.jpg"
  fi

  # Use shared font detection for montage
  detect_font

  # (#5) Run montage, with font fallback and retry
  run_montage() {
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      montage -font "$DETECTED_FONT" "$@"
    else
      montage "$@"
    fi
  }

  # Fallback for failed burn-ins: render timestamps as labels under each cell
  USE_LABELS=false
  if $TIMESTAMPS && [ "$TS_FAILURES" -gt 0 ]; then
    USE_LABELS=true
  fi
  MONTAGE_INPUTS=()
  i=0
  for frame in "${FRAME_FILES[@]}"; do
    if $USE_LABELS; then
      MONTAGE_INPUTS+=(-label "$(format_ts "${FRAME_TIMES[$i]}")" "$frame")
    else
      MONTAGE_INPUTS+=("$frame")
    fi
    i=$((i + 1))
  done

  # -fill white keeps fallback labels readable on the dark background
  MONTAGE_OPTS=(-fill white -tile "$TILE" -geometry "${W_OUT}x${H_OUT}+4+4" -background '#0e0e1a' -quality "$Q")

  MONTAGE_OK=false
  LABELS_DROPPED=false
  if run_montage "${MONTAGE_INPUTS[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_FILE" 2>"$STDERR_TMP"; then
    MONTAGE_OK=true
  elif [ -z "$DETECTED_FONT" ]; then
    # First attempt failed without a font — try forcing font detection and retry
    detect_font
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      if montage -font "$DETECTED_FONT" "${MONTAGE_INPUTS[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_FILE" 2>"$STDERR_TMP"; then
        MONTAGE_OK=true
      fi
    fi
  fi
  if ! $MONTAGE_OK && $USE_LABELS; then
    # Labels also need a working font — last resort: montage without labels
    # (frame→time mapping is still preserved in the filenames)
    if run_montage "${FRAME_FILES[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_FILE" 2>"$STDERR_TMP"; then
      MONTAGE_OK=true
      LABELS_DROPPED=true
    fi
  fi

  if ! $MONTAGE_OK; then
    echo " FAILED" >&2
    echo "Error: montage creation failed" >&2
    if [ -s "$STDERR_TMP" ]; then
      echo "  montage: $(cat "$STDERR_TMP")" >&2
    fi
    exit 1
  fi

  # Verify output file exists and is non-empty (#5)
  if [ ! -s "$MONTAGE_FILE" ]; then
    echo " FAILED" >&2
    echo "Error: montage file was not created or is empty" >&2
    exit 1
  fi

  MONTAGE_SIZE=$(du -h "$MONTAGE_FILE" | cut -f1 | tr -d ' ')
  echo " done"
  if $LABELS_DROPPED; then
    echo "   ⚠️  Timestamp labels failed; montage created without them (timestamps remain in frame filenames)." >&2
  fi
  echo ""
  echo "   📊 Montage: ${BASENAME}_montage_${RUN_ID}.jpg (${TILE} grid, ${MONTAGE_SIZE})"

  # (#6) Only delete this run's prefixed frames
  if $CLEANUP; then
    rm -f -- "${OUTPUT_DIR}/${FRAME_PREFIX}"_*.jpg
    CLEANED=true
    echo "   🧹 Individual frames removed"
  fi
else
  echo ""
fi

# ── Summary ────────────────────────────────────────────────────────────────
TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" | cut -f1 | tr -d ' ')
echo "   📁 Total: ${TOTAL_SIZE} → ${OUTPUT_DIR}/"

if $MONTAGE; then
  MONTAGE_PATH="$(cd -- "$OUTPUT_DIR" && pwd)/${BASENAME}_montage_${RUN_ID}.jpg"
  echo ""
  echo "   💡 Feed to AI:"
  echo "   Read(\"${MONTAGE_PATH}\")"
fi

emit_json
