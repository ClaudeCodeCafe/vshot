#!/bin/bash
set -eo pipefail

# ── vshot — Video frame extraction for AI consumption ──────────────────────
# Extract frames from video and optionally create a montage grid image.
# Designed to let AI assistants "watch" videos via image analysis.

VERSION="0.3.0"
SCRIPT_NAME="vshot"

# Unique prefix per run to avoid stale frame collisions (#1)
# Include epoch seconds to prevent PID-reuse collisions
RUN_ID="$$_$(date +%s)"

# ── Defaults ───────────────────────────────────────────────────────────────
MODE="overview"
FRAMES=20
INTERVAL=""
MONTAGE=false
OUTPUT_DIR=""
TIMESTAMPS=true
CLEANUP=false
SCENE=""
MAX_FRAMES=30
AT=""
COLS_OPT=""
NAME=""
NAME_SET=false
MAX_EDGE=2576
JSON=false
CLEANED=false

# Default mode seeks to each time instead of decoding the whole video once
# when the spacing between frames (duration / frames) is at least this many
# seconds (#10). A single pass costs decode time proportional to the duration;
# seeking costs a roughly fixed time per frame (decode from the previous
# keyframe), so the break-even point is a frame spacing, not a duration.
# Measured on Apple Silicon, ffmpeg 8.1, 1080p30 H.264 testsrc2 (single pass
# vs seek, seconds; output 480x270):
#   20 frames, x264 medium,    GOP 250:  120 s 1.79/2.14  180 s 2.95/2.16  300 s 6.51/2.56
#   20 frames, x264 medium,    GOP 30:    60 s 1.18/1.25  120 s 2.71/1.24  300 s 6.77/1.26
#   20 frames, x264 ultrafast, GOP 250:  120 s 1.02/1.48  180 s 1.52/1.34  600 s 5.09/1.38
#   20 frames, x264 ultrafast, GOP 30:    60 s 0.56/0.80  120 s 1.09/0.91  600 s 6.02/0.88
#   60 frames, x264 ultrafast, GOP 250:  300 s 4.07/5.10  600 s 7.46/5.19
#   60 frames, x264 ultrafast, GOP 30:   180 s 2.56/2.61  300 s 3.63/2.59
# Break-even is ~3-5 s per frame with short GOPs and ~7-8 s with long ones;
# 8 s keeps seeking from ever being noticeably slower (20 frames: >= 160 s).
SEEK_MIN_STEP=8

# ── Usage ──────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${SCRIPT_NAME} v${VERSION} — Video frame extraction for AI consumption

USAGE:
  ${SCRIPT_NAME} <video> [options]

OPTIONS:
  --frames N        Number of frames to extract (default: 20)
                    Note: capped to video duration in seconds for even spacing.
  --interval N      Extract every N seconds (overrides --frames)
  --scene [N]       Extract only scene-change frames (threshold 0.0-1.0, default: 0.3)
                    Lower = more frames, higher = fewer frames. Overrides --frames.
  --max-frames N    Cap on --scene frames (default: 30). Extra scene changes are
                    thinned evenly over time.
  --at LIST         Extract frames at specific times in seconds (comma-separated,
                    decimals allowed, e.g. 3.5,12,48). Overrides --frames/--interval/--scene.
  --mode MODE       overview | text | detail (default: overview)
  --montage         Combine all frames into a single grid image
  --cols N          Number of montage grid columns (default: auto from aspect ratio)
  --name NAME       Write the montage as <output>/NAME.jpg, overwriting any existing
                    file (requires --montage; a trailing .jpg/.jpeg is stripped)
  --max-edge N      Shrink montage cells so the montage long edge fits N px
                    (default: 2576, Claude's image limit; 0 disables)
  --output DIR      Output directory (default: <video>_vshot/)
  --no-timestamps   Don't add timestamps (frame burn-in or montage labels)
  --cleanup         Remove individual frames after creating montage
                    (timestamps then become montage cell labels; no per-frame burn-in)
  --json            Print a machine-readable JSON result line to stdout
                    (human-readable progress goes to stderr)
  -h, --help        Show this help

MODES:
  overview   480x270   Low-res color. Quick overview of video flow.
  text       960x540   Mid-res. Optimized for reading text/UI content.
  detail     1280x720  High-res. Full detail for design review.

EXAMPLES:
  ${SCRIPT_NAME} video.mp4                          # 20 frames, overview
  ${SCRIPT_NAME} video.mp4 --montage                # single grid image
  ${SCRIPT_NAME} video.mp4 --mode text --montage    # text-readable grid
  ${SCRIPT_NAME} video.mp4 --interval 5 --montage   # every 5s, grid
  ${SCRIPT_NAME} video.mp4 --frames 30 --mode detail # 30 high-res frames
  ${SCRIPT_NAME} video.mp4 --scene --montage         # scene changes only
  ${SCRIPT_NAME} video.mp4 --scene 0.5 --montage     # fewer scene changes
  ${SCRIPT_NAME} video.mp4 --scene --max-frames 24 --montage # cap scene frames
  ${SCRIPT_NAME} video.mp4 --at 3.5,12,48 --montage  # pinpoint extraction
  ${SCRIPT_NAME} video.mp4 --montage --json          # machine-readable result
  ${SCRIPT_NAME} video.mp4 --montage --name review   # stable name: review.jpg
EOF
  exit 0
}

# ── Mode resolution lookup ─────────────────────────────────────────────────
get_mode_settings() {
  case "$MODE" in
    overview) W=480;  H=270; Q=70 ;;
    text)     W=960;  H=540; Q=85 ;;
    detail)   W=1280; H=720; Q=90 ;;
    *) echo "Error: unknown mode '$MODE'. Use: overview, text, detail" >&2; exit 1 ;;
  esac
}

# ── Dependency check (#8, #14) ─────────────────────────────────────────────
check_deps() {
  if ! command -v ffmpeg &>/dev/null; then
    echo "Error: ffmpeg is required. Install with your package manager, e.g. brew install ffmpeg" >&2
    exit 1
  fi
  if ! command -v ffprobe &>/dev/null; then
    echo "Error: ffprobe is required (comes with ffmpeg). Install with your package manager, e.g. brew install ffmpeg" >&2
    exit 1
  fi
  if $MONTAGE && ! command -v montage &>/dev/null; then
    echo "Error: ImageMagick is required for --montage. Install with your package manager, e.g. brew install imagemagick" >&2
    exit 1
  fi
}

# ── Validation helpers (#2) ────────────────────────────────────────────────
is_positive_integer() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    0) return 1 ;;
    *) return 0 ;;
  esac
}

# Format seconds (int or float) as M:SS for display
format_ts() {
  echo "$1" | awk '{s = int($1); printf "%d:%02d", int(s / 60), s % 60}'
}

# ── JSON result output (--json) ────────────────────────────────────────────
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Emit one JSON line to fd 3 (the original stdout). No-op without --json.
emit_json() {
  $JSON || return 0
  local out_abs files_json montage_json cell_json i fpath
  out_abs=$(cd -- "$OUTPUT_DIR" 2>/dev/null && pwd)
  [ -z "$out_abs" ] && out_abs="$OUTPUT_DIR"
  files_json=""
  if ! $CLEANED && [ "${#FRAME_FILES[@]}" -gt 0 ]; then
    i=0
    for fpath in "${FRAME_FILES[@]}"; do
      [ -n "$files_json" ] && files_json="${files_json},"
      files_json="${files_json}{\"path\":\"$(json_escape "${out_abs}/$(basename -- "$fpath")")\",\"time\":${FRAME_TIMES[$i]}}"
      i=$((i + 1))
    done
  fi
  if [ -n "${MONTAGE_FILE:-}" ] && [ -s "${MONTAGE_FILE:-}" ]; then
    montage_json="\"$(json_escape "${out_abs}/$(basename -- "$MONTAGE_FILE")")\""
    cell_json="\"${CELL_W}x${CELL_H}\""
  else
    montage_json="null"
    cell_json="null"
  fi
  printf '{"video":"%s","duration":%s,"mode":"%s","frames":%s,"output_dir":"%s","montage":%s,"files":[%s],"montage_cell":%s,"montage_shrunk":%s}\n' \
    "$(json_escape "$VIDEO")" "$DURATION" "$MODE" "${EXTRACTED:-0}" \
    "$(json_escape "$out_abs")" "$montage_json" "$files_json" \
    "$cell_json" "${CELL_SHRUNK:-false}" >&3
}

# ── Font detection (shared by timestamp burn-in and montage) ──────────────
# Homebrew ImageMagick / ffmpeg often lack default font config.
# Detect a usable system font once and reuse it.
DETECTED_FONT=""
detect_font() {
  if [ -n "$DETECTED_FONT" ]; then
    return
  fi
  if command -v fc-match &>/dev/null; then
    DETECTED_FONT=$(fc-match -f '%{file}' 2>/dev/null || true)
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      return
    fi
    DETECTED_FONT=""
  fi
  # Search common system font paths as last resort
  local font_path
  for font_path in \
    /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    /usr/share/fonts/TTF/DejaVuSans.ttf \
    /System/Library/Fonts/Helvetica.ttc \
    /System/Library/Fonts/Geneva.ttf; do
    if [ -f "$font_path" ]; then
      DETECTED_FONT="$font_path"
      return
    fi
  done
  echo "Warning: no usable font found. Timestamps and montage labels may fail." >&2
}

# ── Parse args (#7: check $# before accessing $2) ─────────────────────────
VIDEO=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    -v|--version) echo "${SCRIPT_NAME} v${VERSION}"; exit 0 ;;
    --frames)
      if [ $# -lt 2 ]; then
        echo "Error: --frames requires a value" >&2; exit 1
      fi
      FRAMES="$2"; shift 2 ;;
    --interval)
      if [ $# -lt 2 ]; then
        echo "Error: --interval requires a value" >&2; exit 1
      fi
      INTERVAL="$2"; shift 2 ;;
    --mode)
      if [ $# -lt 2 ]; then
        echo "Error: --mode requires a value" >&2; exit 1
      fi
      MODE="$2"; shift 2 ;;
    --montage) MONTAGE=true; shift ;;
    --output)
      if [ $# -lt 2 ]; then
        echo "Error: --output requires a value" >&2; exit 1
      fi
      OUTPUT_DIR="$2"; shift 2 ;;
    --scene)
      # --scene can optionally take a threshold value (0.0-1.0)
      if [ $# -ge 2 ] && echo "$2" | grep -qE '^(0|0?\.[0-9]+|1(\.0+)?)$'; then
        SCENE="$2"; shift 2
      elif [ $# -ge 2 ] && echo "$2" | grep -qE '^[-+]?([0-9]+\.?[0-9]*|\.[0-9]+)$'; then
        # Numeric but out of range — fail clearly instead of treating it as
        # a video path or an unknown option
        echo "Error: --scene threshold must be a number between 0.0 and 1.0 (e.g. 0.3), got '$2'" >&2; exit 1
      else
        SCENE="0.3"; shift
      fi ;;
    --max-frames)
      if [ $# -lt 2 ]; then
        echo "Error: --max-frames requires a value" >&2; exit 1
      fi
      MAX_FRAMES="$2"; shift 2 ;;
    --at)
      if [ $# -lt 2 ]; then
        echo "Error: --at requires a value" >&2; exit 1
      fi
      AT="$2"; shift 2 ;;
    --cols)
      if [ $# -lt 2 ]; then
        echo "Error: --cols requires a value" >&2; exit 1
      fi
      COLS_OPT="$2"; shift 2 ;;
    --name)
      if [ $# -lt 2 ]; then
        echo "Error: --name requires a value" >&2; exit 1
      fi
      NAME="$2"; NAME_SET=true; shift 2 ;;
    --max-edge)
      if [ $# -lt 2 ]; then
        echo "Error: --max-edge requires a value" >&2; exit 1
      fi
      MAX_EDGE="$2"; shift 2 ;;
    --json) JSON=true; shift ;;
    --no-timestamps) TIMESTAMPS=false; shift ;;
    --cleanup) CLEANUP=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *)
      if [ -z "$VIDEO" ]; then
        VIDEO="$1"
      else
        echo "Error: multiple video files not supported" >&2; exit 1
      fi
      shift ;;
  esac
done

# ── Input validation (#2) ─────────────────────────────────────────────────
if [ -z "$VIDEO" ]; then
  echo "Error: no video file specified" >&2
  echo "Usage: ${SCRIPT_NAME} <video> [options]" >&2
  exit 1
fi

if [ ! -f "$VIDEO" ]; then
  echo "Error: file not found: $VIDEO" >&2
  exit 1
fi

if ! is_positive_integer "$FRAMES"; then
  echo "Error: --frames must be a positive integer, got '$FRAMES'" >&2
  exit 1
fi

if [ -n "$INTERVAL" ]; then
  if ! is_positive_integer "$INTERVAL"; then
    echo "Error: --interval must be a positive integer, got '$INTERVAL'" >&2
    exit 1
  fi
fi

if ! is_positive_integer "$MAX_FRAMES"; then
  echo "Error: --max-frames must be a positive integer, got '$MAX_FRAMES'" >&2
  exit 1
fi
# Normalize to decimal: "08" would otherwise be emitted as invalid JSON and
# parsed as octal by bash arithmetic
MAX_FRAMES=$((10#$MAX_FRAMES))

if [ -n "$COLS_OPT" ] && ! is_positive_integer "$COLS_OPT"; then
  echo "Error: --cols must be a positive integer, got '$COLS_OPT'" >&2
  exit 1
fi

if $NAME_SET; then
  if ! $MONTAGE; then
    echo "Error: --name only applies to the montage; add --montage" >&2
    exit 1
  fi
  case "$NAME" in
    */*) echo "Error: --name must be a file name without '/', got '$NAME'" >&2; exit 1 ;;
  esac
  # Strip a trailing .jpg/.jpeg (any case); vshot always appends .jpg
  case "$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]')" in
    *.jpg) NAME="${NAME%????}" ;;
    *.jpeg) NAME="${NAME%?????}" ;;
  esac
  if [ -z "$NAME" ]; then
    echo "Error: --name must not be empty (or only an extension)" >&2
    exit 1
  fi
fi
case "$MAX_EDGE" in
  ''|*[!0-9]*)
    echo "Error: --max-edge must be a non-negative integer, got '$MAX_EDGE'" >&2
    exit 1 ;;
esac
# Force base 10: a leading zero (e.g. 0800) would otherwise be read as octal
MAX_EDGE=$((10#$MAX_EDGE))

# Parse --at into a validated list (range check happens after duration probe)
AT_MODE=false
AT_RAW=()
if [ -n "$AT" ]; then
  AT_MODE=true
  set -f # no glob expansion of user input
  for t in $(echo "$AT" | tr ',' ' '); do
    if ! echo "$t" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
      echo "Error: --at times must be numbers in seconds, got '$t'" >&2
      exit 1
    fi
    AT_RAW+=("$t")
  done
  set +f
  if [ "${#AT_RAW[@]}" -eq 0 ]; then
    echo "Error: --at requires at least one time value" >&2
    exit 1
  fi
fi

get_mode_settings
check_deps

# --json: route human-readable progress to stderr, keep original stdout on fd 3
if $JSON; then
  exec 3>&1 1>&2
fi

# ── Temp file for capturing stderr (#3) ───────────────────────────────────
STDERR_TMP=$(mktemp "${TMPDIR:-/tmp}/vshot_stderr.XXXXXX")
cleanup_tmp() {
  rm -f -- "$STDERR_TMP" "${PTS_LOG:-}" "${MONTAGE_TMP:-}" 2>/dev/null || true
}
trap cleanup_tmp EXIT

# ── Get video info (#3: capture stderr, check exit codes) ─────────────────
if ! DURATION=$(ffprobe -v error -show_entries format=duration -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP") || [ -z "$DURATION" ]; then
  echo "Error: could not determine video duration" >&2
  if [ -s "$STDERR_TMP" ]; then
    echo "  ffprobe: $(cat "$STDERR_TMP")" >&2
  fi
  exit 1
fi
DURATION=$(echo "$DURATION" | head -1)

# Handle sub-second durations gracefully (#9)
# Use awk instead of bc for portability (#8)
DURATION_INT=$(echo "$DURATION" | awk '{d = int($1); if (d < 1 && $1 > 0) d = 1; print d}')

if [ -z "$DURATION_INT" ] || [ "$DURATION_INT" -eq 0 ] 2>/dev/null; then
  echo "Error: could not determine video duration (got: $DURATION)" >&2
  exit 1
fi

# Sort --at times and drop ones beyond the video duration
if $AT_MODE; then
  AT_ARR=()
  for t in $(printf '%s\n' "${AT_RAW[@]}" | sort -n); do
    if awk -v t="$t" -v d="$DURATION" 'BEGIN{exit !(t < d)}'; then
      AT_ARR+=("$t")
    else
      echo "Warning: --at ${t}s is beyond video duration (${DURATION_INT}s). Skipping." >&2
    fi
  done
  if [ "${#AT_ARR[@]}" -eq 0 ]; then
    echo "Error: all --at times are beyond video duration (${DURATION_INT}s)" >&2
    exit 1
  fi
fi

# Detect original video dimensions (#3, #9, #10: -- before path)
if ! V_WIDTH=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP"); then
  V_WIDTH=""
fi
V_WIDTH=$(echo "$V_WIDTH" | head -1 | tr -d ',[:space:]')

if ! V_HEIGHT=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 -- "$VIDEO" 2>"$STDERR_TMP"); then
  V_HEIGHT=""
fi
V_HEIGHT=$(echo "$V_HEIGHT" | head -1 | tr -d ',[:space:]')

# Validate dimensions (#9)
if [ -z "$V_WIDTH" ] || [ -z "$V_HEIGHT" ]; then
  echo "Error: could not determine video dimensions" >&2
  if [ -s "$STDERR_TMP" ]; then
    echo "  ffprobe: $(cat "$STDERR_TMP")" >&2
  fi
  exit 1
fi
if ! is_positive_integer "$V_WIDTH" || ! is_positive_integer "$V_HEIGHT"; then
  echo "Error: could not determine valid video dimensions (${V_WIDTH}x${V_HEIGHT})" >&2
  exit 1
fi

# Check for rotation metadata (phone videos often store landscape dims + 90° rotation)
V_ROTATION=$(ffprobe -v error -select_streams v:0 -show_entries stream_side_data=rotation -of csv=p=0 -- "$VIDEO" 2>/dev/null | head -1 | tr -d '[:space:]-')
# Swap dimensions if rotated 90 or 270 degrees
if [ "$V_ROTATION" = "90" ] || [ "$V_ROTATION" = "270" ]; then
  V_TMP=$V_WIDTH
  V_WIDTH=$V_HEIGHT
  V_HEIGHT=$V_TMP
fi

# Adjust output dimensions to match source aspect ratio (#8: awk instead of bc)
if [ -n "$V_WIDTH" ] && [ -n "$V_HEIGHT" ] && [ "$V_WIDTH" -gt 0 ]; then
  if [ "$V_HEIGHT" -gt "$V_WIDTH" ]; then
    # Portrait (9:16 etc) — fix height to mode height, scale width proportionally
    H_OUT=$H
    W_OUT=$(echo "$H_OUT $V_WIDTH $V_HEIGHT" | awk '{printf "%d", $1 * $2 / $3}')
    # Ensure even number (ffmpeg requires it)
    W_OUT=$(( (W_OUT / 2) * 2 ))
    ORIENTATION="portrait"
  else
    # Landscape (16:9 etc) — fix width to mode width, scale height proportionally
    W_OUT=$W
    H_OUT=$(echo "$W_OUT $V_HEIGHT $V_WIDTH" | awk '{printf "%d", $1 * $2 / $3}')
    H_OUT=$(( (H_OUT / 2) * 2 ))
    ORIENTATION="landscape"
  fi
  # Clamp to minimum 2 for extreme aspect ratios
  [ "$W_OUT" -lt 2 ] && W_OUT=2
  [ "$H_OUT" -lt 2 ] && H_OUT=2
else
  W_OUT=$W
  H_OUT=$H
  ORIENTATION="landscape"
fi

# ── Calculate frame extraction rate ────────────────────────────────────────
# Two extraction strategies, both reporting the real PTS of each frame:
# - single pass: decode the whole video once, a select filter picks frames and
#   showinfo logs their PTS (--scene, --interval, default mode on short videos)
# - seek: one input-seeking ffmpeg run per time (--at, default mode on long
#   videos); each returns the first frame at or after the requested time
# Even spacing (default / --interval) selects the first frame of each STEP-long
# bucket, i.e. the first frame at or after i * STEP — the same frame a seek to
# i * STEP returns. (The fps filter used before picked frames up to half a STEP
# later than the times they were labelled with.)
bucket_select() {
  echo "select='isnan(prev_selected_t)+gte(floor(t/$1),floor(prev_selected_t/$1)+1)'"
}
SCENE_MODE=false
SEEK_MODE=$AT_MODE
if $AT_MODE; then
  # Pinpoint mode: one ffmpeg seek per requested time (see extraction below)
  FRAMES="${#AT_ARR[@]}"
elif [ -n "$SCENE" ]; then
  # Scene detection: extract only frames where visual change exceeds threshold
  SCENE_MODE=true
  VF_FILTER="select='gt(scene,${SCENE})',showinfo,scale=${W_OUT}:${H_OUT}"
  FRAMES="?"
elif [ -n "$INTERVAL" ]; then
  STEP="$INTERVAL"
  VF_FILTER="$(bucket_select "$STEP"),showinfo,scale=${W_OUT}:${H_OUT}"
  # Don't estimate — actual count depends on the frames present
  FRAMES="?"
else
  # (#12) Warn if FRAMES was capped
  if [ "$FRAMES" -gt "$DURATION_INT" ]; then
    echo "Warning: --frames $FRAMES exceeds video duration (${DURATION_INT}s). Capping to $DURATION_INT." >&2
    FRAMES=$DURATION_INT
  fi
  STEP=$(echo "$DURATION $FRAMES" | awk '{printf "%.4f", $1 / $2}')
  # Seeking costs a roughly fixed time per frame; a single pass costs decode
  # time proportional to the duration. Seek only when it is faster (#10).
  if awk -v s="$STEP" -v m="$SEEK_MIN_STEP" 'BEGIN{exit !(s >= m)}'; then
    SEEK_MODE=true
    AT_ARR=()
    while read -r t; do
      AT_ARR+=("$t")
    done < <(awk -v n="$FRAMES" -v s="$STEP" 'BEGIN{for (i = 0; i < n; i++) printf "%.2f\n", i * s}')
  else
    VF_FILTER="$(bucket_select "$STEP"),showinfo,scale=${W_OUT}:${H_OUT}"
  fi
fi
if ! $SEEK_MODE; then
  # showinfo PTS of each output frame, one per line in output order
  PTS_LOG=$(mktemp "${TMPDIR:-/tmp}/vshot_pts.XXXXXX")
fi

# ── Setup output (#10: -- before path operands) ───────────────────────────
BASENAME=$(basename -- "$VIDEO" | sed 's/\.[^.]*$//')
if [ -z "$OUTPUT_DIR" ]; then
  OUTPUT_DIR="$(dirname -- "$VIDEO")/${BASENAME}_vshot"
fi
# Normalize relative OUTPUT_DIR to prevent special chars breaking find/ffmpeg
# Prefix with ./ unless already absolute or relative (./  ../)
case "$OUTPUT_DIR" in
  /*|./*|../*) ;; # already safe
  *) OUTPUT_DIR="./$OUTPUT_DIR" ;;
esac
mkdir -p -- "$OUTPUT_DIR"

# Frame filename prefix for this run (#1)
FRAME_PREFIX="vshot_${RUN_ID}_frame"

# ── Extract frames (#1, #3, #8, #10) ──────────────────────────────────────
echo "📹 ${SCRIPT_NAME} v${VERSION}"
echo "   Video:    $(basename "$VIDEO") (${DURATION_INT}s, ${V_WIDTH}x${V_HEIGHT} ${ORIENTATION})"
echo "   Mode:     $MODE (${W_OUT}x${H_OUT})"
if $AT_MODE; then
  echo "   At:       $(echo "${AT_ARR[@]}" | tr ' ' ',')s (${FRAMES} frames)"
elif $SCENE_MODE; then
  echo "   Scene:    threshold=${SCENE} (auto frame count, max ${MAX_FRAMES})"
elif [ -n "$INTERVAL" ]; then
  echo "   Interval: every ${INTERVAL}s"
elif $SEEK_MODE; then
  echo "   Frames:   $FRAMES (seeking to each time)"
else
  echo "   Frames:   $FRAMES"
fi
echo "   Output:   $OUTPUT_DIR/"
echo ""

echo -n "   Extracting frames..."

# (#3) Capture stderr, check exit code
# ffmpeg runs at info level so showinfo can log each frame's PTS.
# -pix_fmt yuvj420p: full-range JPEG input for the mjpeg encoder. It also makes
# a seek that finds no frame (past the last video frame) a clean exit 0 with no
# output; otherwise ffmpeg 7+ fails to open the encoder at EOF and exits
# non-zero, which would be indistinguishable from a real error.
# Single pass needs variable frame rate output (one image per selected frame).
# -fps_mode replaced -vsync (ffmpeg 5.1+); ffmpeg 9 removed -vsync entirely
if ffmpeg -hide_banner -h full 2>/dev/null | grep -- '-fps_mode' >/dev/null; then
  EXTRA_OPTS="-fps_mode vfr -pix_fmt yuvj420p"
else
  EXTRA_OPTS="-vsync vfr -pix_fmt yuvj420p"
fi
QV=$(( (100 - Q) * 31 / 100 + 1 ))
FFMPEG_EXIT=0
AT_TIMES=()
# First showinfo pts_time in an ffmpeg log (empty if none)
first_pts() {
  sed -n 's/.*Parsed_showinfo.* pts_time:\([-0-9.e+]*\).*/\1/p' "$1" | head -1
}
if $SEEK_MODE; then
  : > "$STDERR_TMP"
  SEEK_LOG=$(mktemp "${TMPDIR:-/tmp}/vshot_seek.XXXXXX")
  PTS_LOG="$SEEK_LOG" # removed by cleanup_tmp
  n=1
  PREV_T=""
  for t in "${AT_ARR[@]}"; do
    OUT_FRAME="${OUTPUT_DIR}/${FRAME_PREFIX}_$(printf '%04d' "$n").jpg"
    rm -f -- "$OUT_FRAME"
    if ! ffmpeg -v info -hide_banner -nostdin -ss "$t" -i "$VIDEO" \
      -frames:v 1 -update 1 \
      -vf "showinfo,scale=${W_OUT}:${H_OUT}" \
      -pix_fmt yuvj420p -q:v "$QV" \
      "$OUT_FRAME" 2>"$SEEK_LOG"; then
      # Any ffmpeg failure is fatal, even after earlier frames succeeded
      FFMPEG_EXIT=1
      echo "   (while extracting the frame at ${t}s)" >> "$STDERR_TMP"
      cat -- "$SEEK_LOG" >> "$STDERR_TMP"
      rm -f -- "$OUT_FRAME"
      break
    fi
    if [ ! -s "$OUT_FRAME" ]; then
      # ffmpeg succeeded but found no frame at or after t: the time is past the
      # last video frame (e.g. the container/audio is longer than the video)
      rm -f -- "$OUT_FRAME"
      echo "Warning: no video frame at or after ${t}s (past the end of the video stream). Skipping." >&2
      continue
    fi
    # Without -copyts, output PTS are relative to the seek target, so the
    # returned frame's position is t + pts_time (it can be later than t on
    # sparse/VFR video)
    PTS=$(first_pts "$SEEK_LOG")
    if [ -n "$PTS" ]; then
      T=$(awk -v t="$t" -v p="$PTS" 'BEGIN{printf "%.2f", t + p}')
    else
      T=$(awk -v t="$t" 'BEGIN{printf "%.2f", t}')
    fi
    if [ "$T" = "$PREV_T" ]; then
      # Sparse video: this time returned the same frame as the previous one
      rm -f -- "$OUT_FRAME"
      echo "Note: ${t}s returns the frame at ${T}s again. Skipping duplicate." >&2
      continue
    fi
    AT_TIMES+=("$T")
    PREV_T="$T"
    n=$((n + 1))
  done
else
  # shellcheck disable=SC2086
  ffmpeg -v info -hide_banner -nostdin -i "$VIDEO" \
    -vf "${VF_FILTER}" \
    $EXTRA_OPTS \
    -q:v "$QV" \
    "${OUTPUT_DIR}/${FRAME_PREFIX}_%04d.jpg" \
    2>"$STDERR_TMP" || FFMPEG_EXIT=$?
  # Extract PTS values from showinfo output (one line per output frame)
  grep 'Parsed_showinfo.* pts_time:' "$STDERR_TMP" 2>/dev/null \
    | sed 's/.* pts_time:\([-0-9.e+]*\).*/\1/' > "$PTS_LOG" || true
fi

# (#4) Use find for frame counting (bash 3 compatible)
EXTRACTED=$(find "$OUTPUT_DIR" -name "${FRAME_PREFIX}_*.jpg" -type f 2>/dev/null | wc -l | tr -d ' ')

if [ "$FFMPEG_EXIT" -ne 0 ]; then
  if $SCENE_MODE && [ "$EXTRACTED" -eq 0 ]; then
    # Scene mode: distinguish "no frames matched" from real errors
    # Check if stderr contains actual error messages (beyond showinfo output)
    HAS_REAL_ERROR=false
    if [ -s "$STDERR_TMP" ]; then
      # Filter out showinfo lines — anything remaining is a real error
      if grep -v -E '^\[Parsed_showinfo|pts:|fmt:|config:|n:' "$STDERR_TMP" | grep -qi 'error\|denied\|invalid\|failed\|cannot' 2>/dev/null; then
        HAS_REAL_ERROR=true
      fi
    fi
    if $HAS_REAL_ERROR; then
      echo " FAILED" >&2
      echo "Error: ffmpeg frame extraction failed" >&2
      grep -v -E '^\[Parsed_showinfo' "$STDERR_TMP" >&2
      exit 1
    fi
    # Genuine 0-scene result
    echo " done (0 frames)"
    echo ""
    echo "   ⚠️  No scene changes detected at threshold=${SCENE}. Try a lower value (e.g. --scene 0.2)."
    TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" 2>/dev/null | cut -f1 | tr -d ' ')
    echo "   📁 Total: ${TOTAL_SIZE:-0B} → ${OUTPUT_DIR}/"
    emit_json
    exit 2
  else
    echo " FAILED" >&2
    echo "Error: ffmpeg frame extraction failed" >&2
    if [ -s "$STDERR_TMP" ]; then
      # info-level log: drop per-frame showinfo lines, keep the tail (errors)
      echo "  ffmpeg:" >&2
      grep -v 'Parsed_showinfo' "$STDERR_TMP" | tail -n 20 >&2 || true
    fi
    exit 1
  fi
fi

echo " done (${EXTRACTED} frames)"

# ── Cap scene frames (--max-frames) ────────────────────────────────────────
# Thin evenly over time using the captured scene PTS values: for each of N
# targets spaced evenly between the first and last scene time, keep the
# not-yet-chosen scene closest to it (first and last always kept; ties go to
# the earlier scene). Falls back to evenly spaced indices if the PTS log does
# not line up with the extracted frames. Frames and PTS log lines are both in
# output order, so the PTS log is rewritten to the kept lines to keep
# timestamps aligned.
if $SCENE_MODE && [ "$EXTRACTED" -gt "$MAX_FRAMES" ]; then
  echo "   ⚠️  ${EXTRACTED} scene changes detected; thinning evenly to --max-frames ${MAX_FRAMES}." >&2
  PTS_SRC="$PTS_LOG"
  if [ ! -s "$PTS_SRC" ] || [ "$(awk 'END {print NR}' "$PTS_SRC")" -ne "$EXTRACTED" ]; then
    PTS_SRC=/dev/null
  fi
  KEEP_LIST=$(awk -v e="$EXTRACTED" -v n="$MAX_FRAMES" '
    { pts[NR - 1] = $1 + 0 }
    END {
      if (NR != e) for (j = 0; j < e; j++) pts[j] = j
      used[0] = 1; print 0
      if (n == 1) exit
      used[e - 1] = 1; print e - 1
      first = pts[0]; last = pts[e - 1]
      for (k = 1; k < n - 1; k++) {
        target = first + k * (last - first) / (n - 1)
        best = -1
        for (j = 0; j < e; j++) {
          if (j in used) continue
          d = pts[j] - target; if (d < 0) d = -d
          if (best < 0 || d < bestd) { best = j; bestd = d }
        }
        used[best] = 1; print best
      }
    }' "$PTS_SRC")
  PTS_KEPT=$(mktemp "${TMPDIR:-/tmp}/vshot_pts.XXXXXX")
  i=0
  for frame in "${OUTPUT_DIR}/${FRAME_PREFIX}"_*.jpg; do
    if echo "$KEEP_LIST" | grep -qx "$i"; then
      [ -s "$PTS_LOG" ] && awk -v n="$((i + 1))" 'NR == n {print; exit}' "$PTS_LOG" >> "$PTS_KEPT"
    else
      rm -f -- "$frame"
    fi
    i=$((i + 1))
  done
  mv -- "$PTS_KEPT" "$PTS_LOG"
  EXTRACTED="$MAX_FRAMES"
fi

if [ "$EXTRACTED" -eq 0 ]; then
  if $SCENE_MODE; then
    echo ""
    echo "   ⚠️  No scene changes detected at threshold=${SCENE}. Try a lower value (e.g. --scene 0.2)."
    TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" 2>/dev/null | cut -f1 | tr -d ' ')
    echo "   📁 Total: ${TOTAL_SIZE:-0B} → ${OUTPUT_DIR}/"
    emit_json
    exit 2
  fi
  echo "Error: no frames were extracted" >&2
  exit 1
fi

# ── Per-frame timestamps ───────────────────────────────────────────────────
# Computed once, shared by filename embedding, burn-in, montage labels, --json.
FRAME_FILES=()
FRAME_TIMES=()
# Single pass: use the showinfo PTS log when it lines up with the extracted
# frames; otherwise fall back to evenly spaced estimates
USE_PTS_LOG=false
if ! $SEEK_MODE; then
  if [ -s "$PTS_LOG" ] && [ "$(awk 'END {print NR}' "$PTS_LOG")" -eq "$EXTRACTED" ]; then
    USE_PTS_LOG=true
  elif [ -n "$INTERVAL" ]; then
    STEP="$INTERVAL"
  else
    STEP=$(echo "$DURATION $EXTRACTED" | awk '{printf "%.4f", $1 / $2}')
  fi
fi
i=0
for frame in "${OUTPUT_DIR}/${FRAME_PREFIX}"_*.jpg; do
  if $SEEK_MODE; then
    T="${AT_TIMES[$i]}"
  elif $USE_PTS_LOG; then
    # Actual PTS from the showinfo log (1-indexed line for 0-indexed i)
    T=$(awk -v n="$((i + 1))" 'NR == n {printf "%.2f", $1; exit}' "$PTS_LOG")
  else
    T=$(echo "$i $STEP" | awk '{printf "%.2f", $1 * $2}')
  fi
  [ -z "$T" ] && T=0
  # Embed the timestamp into the filename so frame→time mapping survives
  # even when drawtext burn-in fails (missing font / no drawtext filter)
  TS_SUFFIX=$(echo "$T" | awk '{s = $1; m = int(s / 60); r = s - m * 60;
    if (r == int(r)) printf "t%dm%02ds", m, r; else printf "t%dm%04.1fs", m, r}')
  NEW_FRAME="${frame%.jpg}_${TS_SUFFIX}.jpg"
  mv -- "$frame" "$NEW_FRAME"
  FRAME_FILES+=("$NEW_FRAME")
  FRAME_TIMES+=("$T")
  i=$((i + 1))
done

# ── Burn timestamps (#15: count and warn on failures) ─────────────────────
# (#11) With --montage --cleanup the frames are deleted anyway, so skip the
# per-frame re-encode and render timestamps as montage cell labels instead
LABELS_ONLY=false
if $TIMESTAMPS && $MONTAGE && $CLEANUP; then
  LABELS_ONLY=true
fi
TS_FAILURES=0
if $TIMESTAMPS && ! $LABELS_ONLY && [ "$EXTRACTED" -gt 0 ]; then
  echo -n "   Adding timestamps..."
  detect_font
  # Build fontfile option for drawtext if a font was detected
  # Escape colons and backslashes in font path for ffmpeg filter syntax (#6)
  DRAWTEXT_FONT=""
  if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
    ESCAPED_FONT=$(echo "$DETECTED_FONT" | sed "s/\\\\/\\\\\\\\\\\\\\\\/g; s/:/\\\\\\\\:/g; s/'/\\\\\\\\'/g")
    DRAWTEXT_FONT=":fontfile='${ESCAPED_FONT}'"
  fi

  # drawtext can be missing entirely (e.g. Homebrew ffmpeg 8 builds without
  # freetype) — detect once, then fall back to ImageMagick annotate per frame
  HAS_DRAWTEXT=false
  if ffmpeg -hide_banner -filters 2>/dev/null | grep -q drawtext; then
    HAS_DRAWTEXT=true
  fi
  IM_ANNOTATE=$(command -v magick || command -v convert || true)
  IM_FONT=()
  if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
    IM_FONT=(-font "$DETECTED_FONT")
  fi

  i=0
  for frame in "${FRAME_FILES[@]}"; do
    TS=$(format_ts "${FRAME_TIMES[$i]}")
    BURNED=false

    if $HAS_DRAWTEXT; then
      if ffmpeg -v error -y -i "$frame" \
        -vf "drawtext=text='${TS}':x=8:y=h-24:fontsize=16:fontcolor=white:borderw=2:bordercolor=black${DRAWTEXT_FONT}" \
        "${frame}.tmp.jpg" 2>"$STDERR_TMP" && [ -s "${frame}.tmp.jpg" ]; then
        mv -- "${frame}.tmp.jpg" "$frame"
        BURNED=true
      else
        rm -f -- "${frame}.tmp.jpg"
      fi
    fi

    if ! $BURNED && [ -n "$IM_ANNOTATE" ]; then
      if "$IM_ANNOTATE" "$frame" "${IM_FONT[@]}" \
        -gravity southwest -pointsize 16 -fill white -undercolor '#000000' \
        -annotate +8+8 "$TS" \
        "${frame}.tmp.jpg" 2>"$STDERR_TMP" && [ -s "${frame}.tmp.jpg" ]; then
        mv -- "${frame}.tmp.jpg" "$frame"
        BURNED=true
      else
        rm -f -- "${frame}.tmp.jpg"
      fi
    fi

    if ! $BURNED; then
      TS_FAILURES=$((TS_FAILURES + 1))
    fi
    i=$((i + 1))
  done
  if [ "$TS_FAILURES" -eq "$EXTRACTED" ]; then
    echo " FAILED (all ${TS_FAILURES} frames)" >&2
    echo "   ⚠️  All timestamp burn-ins failed. Falling back to filename timestamps (and montage cell labels with --montage)." >&2
  elif [ "$TS_FAILURES" -gt 0 ]; then
    echo " done (${TS_FAILURES}/${EXTRACTED} timestamp burn-in(s) failed — montage will use cell labels)"
  else
    echo " done"
  fi
fi

# ── Create montage (#5: proper error handling) ────────────────────────────
if $MONTAGE && [ "$EXTRACTED" -gt 0 ]; then
  echo -n "   Creating montage..."

  # Calculate grid: aim for a reasonable final image aspect ratio (#8: awk instead of bc)
  if [ -n "$COLS_OPT" ]; then
    COLS="$COLS_OPT"
    [ "$COLS" -gt "$EXTRACTED" ] && COLS="$EXTRACTED"
  else
    if [ "$ORIENTATION" = "portrait" ]; then
      # Portrait frames: more columns to fill horizontal space
      COLS=$(echo "$EXTRACTED" | awk '{printf "%d", sqrt($1 * 2)}')
    else
      # Landscape frames: standard 16:9-ish grid
      COLS=$(echo "$EXTRACTED" | awk '{printf "%d", sqrt($1 * 16 / 9)}')
    fi
    [ "$COLS" -lt 2 ] && COLS=2
  fi
  ROWS=$(( (EXTRACTED + COLS - 1) / COLS ))

  TILE="${COLS}x${ROWS}"
  if $NAME_SET; then
    MONTAGE_FILE="${OUTPUT_DIR}/${NAME}.jpg"
  else
    MONTAGE_FILE="${OUTPUT_DIR}/${BASENAME}_montage_${RUN_ID}.jpg"
  fi
  # ImageMagick expands %d / [..] in output filenames, so render to a temp
  # name we control (RUN_ID is digits and "_") and rename to the literal path.
  MONTAGE_TMP="${OUTPUT_DIR}/.vshot_montage_${RUN_ID}.tmp.jpg"
  # Remove any previous file so a stale montage can't pass as this run's result
  rm -f -- "$MONTAGE_FILE" "$MONTAGE_TMP"

  # Use shared font detection for montage
  detect_font

  # (#5) Run montage, with font fallback and retry
  run_montage() {
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      montage -font "$DETECTED_FONT" "$@"
    else
      montage "$@"
    fi
  }

  # Labels under each cell: fallback for failed burn-ins, or the only
  # timestamp rendering when burn-in was skipped (#11)
  USE_LABELS=false
  if $TIMESTAMPS && { $LABELS_ONLY || [ "$TS_FAILURES" -gt 0 ]; }; then
    USE_LABELS=true
  fi
  MONTAGE_INPUTS=()
  i=0
  for frame in "${FRAME_FILES[@]}"; do
    if $USE_LABELS; then
      MONTAGE_INPUTS+=(-label "$(format_ts "${FRAME_TIMES[$i]}")" "$frame")
    else
      MONTAGE_INPUTS+=("$frame")
    fi
    i=$((i + 1))
  done

  # Fit the montage long edge within --max-edge (#3): Claude's Read tool
  # downscales larger images anyway, so shrink cells instead of wasting pixels.
  # Each cell is (W+8)x(H+8) with the +4+4 border; reserve ~24px per row for
  # timestamp labels. Extracted frames keep the full mode resolution.
  CELL_W=$W_OUT
  CELL_H=$H_OUT
  CELL_SHRUNK=false
  if [ "$MAX_EDGE" -gt 0 ]; then
    LABEL_H=0
    # Labels are capped at 24pt when fitting (see LABEL_PT below), ~32px tall
    $USE_LABELS && LABEL_H=32
    # Smallest cell keeping the frame aspect with a 2px short side; the cap
    # cannot go below the grid of such cells plus borders/labels.
    if [ "$W_OUT" -ge "$H_OUT" ]; then
      MIN_CELL_H=2
      MIN_CELL_W=$(( (2 * W_OUT + H_OUT - 1) / H_OUT ))
    else
      MIN_CELL_W=2
      MIN_CELL_H=$(( (2 * H_OUT + W_OUT - 1) / W_OUT ))
    fi
    MIN_EDGE_W=$(( COLS * (MIN_CELL_W + 8) ))
    MIN_EDGE_H=$(( ROWS * (MIN_CELL_H + 8 + LABEL_H) ))
    MIN_EDGE=$MIN_EDGE_W
    [ "$MIN_EDGE_H" -gt "$MIN_EDGE" ] && MIN_EDGE=$MIN_EDGE_H
    if [ "$MAX_EDGE" -lt "$MIN_EDGE" ]; then
      echo " FAILED" >&2
      echo "Error: --max-edge ${MAX_EDGE} is too small for a ${COLS}x${ROWS} montage grid (minimum ${MIN_EDGE})." >&2
      echo "  Use --max-edge ${MIN_EDGE} or larger, fewer frames (--frames / --at), or --max-edge 0 to disable." >&2
      exit 1
    fi
    FIT_W=$(( MAX_EDGE / COLS - 8 ))
    FIT_H=$(( MAX_EDGE / ROWS - 8 - LABEL_H ))
    if [ "$CELL_W" -gt "$FIT_W" ]; then
      CELL_H=$(( CELL_H * FIT_W / CELL_W ))
      CELL_W=$FIT_W
    fi
    if [ "$CELL_H" -gt "$FIT_H" ]; then
      CELL_W=$(( CELL_W * FIT_H / CELL_H ))
      CELL_H=$FIT_H
    fi
    # Geometry <= 0 would mean "no resize" to ImageMagick
    [ "$CELL_W" -lt 2 ] && CELL_W=2
    [ "$CELL_H" -lt 2 ] && CELL_H=2
    if [ "$CELL_W" -ne "$W_OUT" ] || [ "$CELL_H" -ne "$H_OUT" ]; then
      CELL_SHRUNK=true
    fi
  fi

  # -fill white keeps labels readable on the dark background; scale the
  # label size with the (possibly shrunk) cell width so it survives
  # downscaling of wide grids. When fitting --max-edge, cap it at 24pt so it
  # stays within the per-row label height reserved above.
  LABEL_PT=$(( CELL_W / 24 ))
  [ "$LABEL_PT" -lt 16 ] && LABEL_PT=16
  [ "$MAX_EDGE" -gt 0 ] && [ "$LABEL_PT" -gt 24 ] && LABEL_PT=24
  MONTAGE_OPTS=(-fill white -pointsize "$LABEL_PT" -tile "$TILE" -geometry "${CELL_W}x${CELL_H}+4+4" -background '#0e0e1a' -quality "$Q")

  MONTAGE_OK=false
  LABELS_DROPPED=false
  if run_montage "${MONTAGE_INPUTS[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_TMP" 2>"$STDERR_TMP"; then
    MONTAGE_OK=true
  elif [ -z "$DETECTED_FONT" ]; then
    # First attempt failed without a font — try forcing font detection and retry
    detect_font
    if [ -n "$DETECTED_FONT" ] && [ -f "$DETECTED_FONT" ]; then
      if montage -font "$DETECTED_FONT" "${MONTAGE_INPUTS[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_TMP" 2>"$STDERR_TMP"; then
        MONTAGE_OK=true
      fi
    fi
  fi
  if ! $MONTAGE_OK && $USE_LABELS; then
    # Labels also need a working font — last resort: montage without labels
    # (frame→time mapping is still preserved in the filenames)
    if run_montage "${FRAME_FILES[@]}" "${MONTAGE_OPTS[@]}" "$MONTAGE_TMP" 2>"$STDERR_TMP"; then
      MONTAGE_OK=true
      LABELS_DROPPED=true
    fi
  fi

  if ! $MONTAGE_OK; then
    echo " FAILED" >&2
    echo "Error: montage creation failed" >&2
    if [ -s "$STDERR_TMP" ]; then
      echo "  montage: $(cat "$STDERR_TMP")" >&2
    fi
    exit 1
  fi

  # Verify output file exists and is non-empty (#5)
  if [ ! -s "$MONTAGE_TMP" ]; then
    echo " FAILED" >&2
    echo "Error: montage file was not created or is empty" >&2
    exit 1
  fi
  if ! mv -f -- "$MONTAGE_TMP" "$MONTAGE_FILE"; then
    echo " FAILED" >&2
    echo "Error: could not move montage to ${MONTAGE_FILE}" >&2
    exit 1
  fi

  MONTAGE_SIZE=$(du -h "$MONTAGE_FILE" | cut -f1 | tr -d ' ')
  echo " done"
  if $LABELS_DROPPED; then
    echo "   ⚠️  Timestamp labels failed; montage created without them (timestamps remain in frame filenames)." >&2
  fi
  if $CELL_SHRUNK; then
    echo "   ℹ️  Montage cells shrunk to ${CELL_W}x${CELL_H} (from ${W_OUT}x${H_OUT}) to fit --max-edge ${MAX_EDGE}." >&2
    echo "      For larger cells use fewer frames (--frames / --at) or --max-edge 0 (frames on disk keep full resolution)." >&2
  fi
  echo ""
  echo "   📊 Montage: $(basename -- "$MONTAGE_FILE") (${TILE} grid, ${MONTAGE_SIZE})"

  # (#6) Only delete this run's prefixed frames
  # (#11) Keep them if labels were dropped: filenames are then the only
  # remaining frame→time mapping
  if $CLEANUP && $LABELS_DROPPED; then
    echo "   ⚠️  --cleanup skipped: individual frames kept to preserve timestamps." >&2
  elif $CLEANUP; then
    rm -f -- "${OUTPUT_DIR}/${FRAME_PREFIX}"_*.jpg
    CLEANED=true
    echo "   🧹 Individual frames removed"
  fi
else
  echo ""
fi

# ── Summary ────────────────────────────────────────────────────────────────
TOTAL_SIZE=$(du -sh "$OUTPUT_DIR" | cut -f1 | tr -d ' ')
echo "   📁 Total: ${TOTAL_SIZE} → ${OUTPUT_DIR}/"

if $MONTAGE && [ -n "${MONTAGE_FILE:-}" ]; then
  MONTAGE_PATH="$(cd -- "$OUTPUT_DIR" && pwd)/$(basename -- "$MONTAGE_FILE")"
  echo ""
  echo "   💡 Feed to AI:"
  echo "   Read(\"${MONTAGE_PATH}\")"
fi

emit_json
